    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const out = $json.output || {};\nconst app = $('Prepare Application').item.json;\nconst errors = [];\n\nconst score = Number(out.score);\nif (!Number.isFinite(score) || score < 0 || score > 100) {\n  errors.push('Score must be a number between 0 and 100');\n}\n\nconst summary = String(out.summary || '').trim();\nif (summary.length < 10) errors.push('Summary is missing');\n\nlet decision = '';\nif (errors.length === 0) {\n  decision = score >= 75 ? 'interview' : score >= 50 ? 'borderline' : 'decline';\n}\n\nreturn {\n  json: {\n    rowNumber: app.rowNumber,\n    fullName: app.fullName,\n    email: app.email,\n    position: app.position,\n    score,\n    decision,\n    summary,\n    strengths: Array.isArray(out.strengths) ? out.strengths.join(', ') : '',\n    gaps: Array.isArray(out.gaps) ? out.gaps.join(', ') : '',\n    isValid: errors.length === 0,\n    errors: errors.join(', ')\n  }\n};"
      },
