    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\nconst errors = [];\n\nconst name = (data['Full Name'] || '').trim();\nconst email = (data['Email'] || '').trim().toLowerCase();\nconst phone = (data['Phone'] || '').trim();\nconst position = data['Position'] || '';\n\nif (name.length < 3) errors.push('Full Name must be at least 3 characters');\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('Email is not valid');\n\nif (!/^\\+?[0-9]{10,15}$/.test(phone.replace(/[\\s-]/g, ''))) errors.push('Phone must be 10 to 15 digits');\n\nif (!position) errors.push('Position is required');\n\nconst hasCV = $input.item.binary && Object.keys($input.item.binary).length > 0;\nif (!hasCV) errors.push('CV file is missing');\n\nreturn {\n  json: {\n    fullName: name,\n    email,\n    phone,\n    position,\n    isValid: errors.length === 0,\n    errors: errors.join(', ')\n  },\n  binary: $input.item.binary\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        -16
