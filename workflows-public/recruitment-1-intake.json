    {
      "parameters": {
        "jsCode": "const current = $('Validate Submission').first();\nconst rows = $input.all().map(i => i.json);\n\nconst email = current.json.email;\nconst position = current.json.position;\n\nconst isDuplicate = rows.some(r =>\n  String(r['Email'] || '').trim().toLowerCase() === email &&\n  String(r['Position'] || '').trim() === position\n);\n\nreturn [{\n  json: { ...current.json, isDuplicate },\n  binary: current.binary\n}];"
      },
