    {
      "parameters": {
        "jsCode": "const HOURS = 2;\n\nconst parseDate = (v) => {\n  if (typeof v === 'number') return (v - 25569) * 86400000;\n  return new Date(v).getTime();\n};\n\nconst rows = $input.all()\n  .map((i) => i.json)\n  .filter((r) => r['Application ID']);\n\nconst now = Date.now();\n\nconst stuck = rows\n  .filter((r) => String(r.Status || '').trim().toLowerCase() === 'waiting')\n  .map((r) => {\n    const t = parseDate(r['Last Updated']);\n    return { ...r, hoursWaiting: isNaN(t) ? null : (now - t) / 3600000 };\n  })\n  .filter((r) => r.hoursWaiting !== null && r.hoursWaiting > HOURS);\n\nif (stuck.length === 0) {\n  return [{ json: { hasStuck: false, count: 0 } }];\n}\n\nconst td = 'padding:6px;border:1px solid #ddd';\nconst rowsHtml = stuck.map((r) =>\n  '<tr>' +\n  '<td style=\"' + td + '\">' + r['Application ID'] + '</td>' +\n  '<td style=\"' + td + '\">' + (r.Name || '') + '</td>' +\n  '<td style=\"' + td + '\">' + (r.Email || '') + '</td>' +\n  '<td style=\"' + td + '\">' + r.hoursWaiting.toFixed(1) + ' h</td>' +\n  '</tr>'\n).join('');\n\nconst html =\n  '<h2>Stuck Applications</h2>' +\n  '<p><b>' + stuck.length + '</b> application(s) waiting more than ' + HOURS + ' hours:</p>' +\n  '<table style=\"border-collapse:collapse;font-family:Arial;font-size:13px\">' +\n  '<tr style=\"background:#1F4E78;color:#fff\"><th style=\"padding:6px\">ID</th><th style=\"padding:6px\">Name</th><th style=\"padding:6px\">Email</th><th style=\"padding:6px\">Waiting</th></tr>' +\n  rowsHtml +\n  '</table>';\n\nconst details = stuck\n  .map((r) => r['Application ID'] + ' (' + r.hoursWaiting.toFixed(1) + 'h)')\n  .join(', ');\n\nreturn [{\n  json: {\n    hasStuck: true,\n    count: stuck.length,\n    subject: stuck.length + ' stuck application(s)',\n    details: details,\n    html: html\n  }\n}];"
      },
