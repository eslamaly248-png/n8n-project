      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst err = e.execution?.error?.message || 'unknown';\nconst workflow = e.workflow?.name || 'unknown';\nconst node = e.execution?.lastNodeExecuted || 'unknown';\n\n// النص اللي بنطابق عليه القواعد\nconst text = `${err} ${e.execution?.error?.description || ''}`.toLowerCase();\n\n// First matching rule wins, so the most specific rules come first.\nconst rules = [\n  { type: 'auth', severity: 'critical',\n    pattern: /401|403|unauthori[sz]ed|forbidden|invalid_grant|invalid credentials|token (has )?expired|reauthori|access denied/,\n    fix: 'Reconnect the credential used by this node (Credentials, then Reconnect), then retry the execution. Retrying alone will not help.' },\n  { type: 'rate_limit', severity: 'warning',\n    pattern: /429|rate limit|too many requests|quota|resource has been exhausted/,\n    fix: 'Temporary. The next scheduled run usually succeeds. If it keeps happening, run the batch less often or upgrade the API plan.' },\n  { type: 'network', severity: 'warning',\n    pattern: /timeout|timed out|etimedout|econnreset|econnrefused|enotfound|socket hang up|\\b50[234]\\b|service unavailable|bad gateway/,\n    fix: 'Temporary network or service problem. Retry the execution; check the service status page if it repeats.' },\n  { type: 'ai_output', severity: 'warning',\n    pattern: /output parser|could not parse|parseable|unexpected token|json|schema/,\n    fix: 'The AI returned an unexpected format. Retry once; if it repeats, tighten the prompt or the output schema.' },\n  { type: 'data', severity: 'critical',\n    pattern: /cannot read propert|undefined|is not defined|not found|no column|missing|invalid syntax|expression|does not exist/,\n    fix: 'Data or workflow bug. Open the execution, find the input that broke this node, fix the data or the expression, then retry.' },\n];\n\nconst rule = rules.find(r => r.pattern.test(text)) ||\n  { type: 'unknown', severity: 'critical', fix: 'Unrecognised error. Open the execution and read the full error.' };\n\nconst now = new Date();\n\nreturn [{\n  json: {\n    Time: now.toISOString(),\n    Workflow: workflow,\n    Node: node,\n    Type: rule.type,\n    Severity: rule.severity,\n    Message: err,\n    'Suggested Fix': rule.fix,\n    'Execution ID': e.execution?.id || '',\n    'Execution Link': e.execution?.url || '',\n    Fingerprint: `${workflow}|${node}|${rule.type}`,\n    'Epoch Minute': Math.floor(now.getTime() / 60000),\n    Alerted: '',\n    Status: 'Open'\n  }\n}];"
      },
