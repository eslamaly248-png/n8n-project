      "webhookId": "6419f8c0-a801-4019-bbc0-f8d4e01e2e64"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r['Epoch Minute']); // يتجاهل الصفوف الفاضية\n\nconst nowMin = Math.floor(Date.now() / 60000);\nconst last24 = rows.filter(r => (nowMin - Number(r['Epoch Minute'])) <= 24 * 60);\n\nif (last24.length === 0) {\n  return [{ json: { hasErrors: false } }];\n}\n\n// عدّ حسب الـ Severity\nconst bySeverity = {};\nfor (const r of last24) {\n  const s = r.Severity || 'unknown';\n  bySeverity[s] = (bySeverity[s] || 0) + 1;\n}\n\n// تجميع حسب الـ Workflow و Type\nconst groups = {};\nfor (const r of last24) {\n  const key = `${r.Workflow} | ${r.Type}`;\n  if (!groups[key]) {\n    groups[key] = {\n      workflow: r.Workflow,\n      type: r.Type,\n      severity: r.Severity,\n      count: 0,\n      lastNode: r.Node,\n      fix: r['Suggested Fix'],\n      link: r['Execution Link']\n    };\n  }\n  groups[key].count++;\n}\n\nconst sorted = Object.values(groups).sort((a, b) => {\n  const order = { critical: 0, warning: 1 };\n  return (order[a.severity] ?? 2) - (order[b.severity] ?? 2) || b.count - a.count;\n});\n\nconst critical = bySeverity.critical || 0;\nconst warning = bySeverity.warning || 0;\n\nconst rowsHtml = sorted.map(g => `\n  <tr>\n    <td style=\"padding:6px;border:1px solid #ddd\">${g.severity === 'critical' ? '🔴' : '🟡'} ${g.severity}</td>\n    <td style=\"padding:6px;border:1px solid #ddd\">${g.workflow}</td>\n    <td style=\"padding:6px;border:1px solid #ddd\">${g.lastNode}</td>\n    <td style=\"padding:6px;border:1px solid #ddd\">${g.type}</td>\n    <td style=\"padding:6px;border:1px solid #ddd;text-align:center\">${g.count}</td>\n    <td style=\"padding:6px;border:1px solid #ddd\">${g.fix}</td>\n  </tr>`).join('');\n\nconst html = `\n<h2>Daily Error Digest</h2>\n<p>Last 24 hours: <b>${last24.length}</b> errors\n(🔴 critical: ${critical}, 🟡 warning: ${warning})</p>\n<table style=\"border-collapse:collapse;font-family:Arial;font-size:13px\">\n  <tr style=\"background:#1F4E78;color:#fff\">\n    <th style=\"padding:6px\">Severity</th><th style=\"padding:6px\">Workflow</th>\n    <th style=\"padding:6px\">Node</th><th style=\"padding:6px\">Type</th>\n    <th style=\"padding:6px\">Count</th><th style=\"padding:6px\">Suggested Fix</th>\n  </tr>\n  ${rowsHtml}\n</table>`;\n\nreturn [{\n  json: {\n    hasErrors: true,\n    total: last24.length,\n    critical,\n    warning,\n    subject: `📊 Daily Digest: ${last24.length} errors (${critical} critical)`,\n    html\n  }\n}];"
      },
